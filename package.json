{
  "name": "gemini-connector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal remote MCP connector that gives Claude access to Google Gemini models as a gap-filler and verifier.",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250529.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.100.0"
  }
}
