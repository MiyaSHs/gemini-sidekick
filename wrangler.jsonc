{
  // Cloudflare Worker config for the personal Gemini MCP connector.
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gemini-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",

  // KV namespace for hosted image/media bytes (served from /img/<id>) and the
  // optional daily-call counter. The id is committed so Git-based auto-deploy
  // (Cloudflare Workers Builds) works without any interactive prompt. If you ever
  // recreate the namespace, REPLACE this id by hand — do NOT accept wrangler's
  // "add it on your behalf" prompt, which appends a second MEDIA binding and
  // breaks the config (that's the error you hit during manual setup).
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "b3f7047a87ff41579e9ce8c151759c19"
    }
  ],

  // Non-secret config. Secrets (GEMINI_API_KEY, CONNECTOR_SECRET) are set with
  // `wrangler secret put` — never put them here.
  "vars": {
    // Optional circuit breaker. "0" or "" disables it. e.g. "200" caps billable
    // Gemini calls per UTC day. This is a guard rail, not your real safety net —
    // set a Google Cloud budget alert too (see README "Billing safety").
    "DAILY_CALL_CAP": "0",
    // How long hosted images live in KV, in seconds. Default 30 days. Images must
    // outlive an editing session so you can keep refining a result across turns.
    "IMAGE_TTL_SECONDS": "2592000"
  },

  "observability": {
    "enabled": true
  }
}
